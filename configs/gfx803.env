# Fase 4 — soporte explícito gfx803 (Polaris RX 570). Se exporta en build Y en runtime.

# Arquitectura objetivo en TODA la cadena de compilación (PyTorch, rocBLAS/Tensile, etc.)
export PYTORCH_ROCM_ARCH=gfx803
export AMDGPU_TARGETS=gfx803
export GPU_TARGETS=gfx803
export HCC_AMDGPU_TARGET=gfx803          # legado, por si alguna parte lo lee

# hipBLASLt NO soporta Polaris → forzar ruta clásica rocBLAS
export TORCH_BLAS_PREFER_HIPBLASLT=0

# Para CMake (Fase 4/5):  -DAMDGPU_TARGETS=gfx803 -DGPU_TARGETS=gfx803

# ---- Runtime: override de versión gfx si el KFD del kernel 6.17 no negocia gfx803 ----
# Polaris RX 570 = gfx803 = ISA 8.0.3. Descomenta SOLO si device_count()==0 pese a /dev/kfd:
# export HSA_OVERRIDE_GFX_VERSION=8.0.3

# ---- Experimental (Fase 7): solo si hay cuelgues/errores de transferencia DMA ----
# export HSA_ENABLE_SDMA=0
