# Fase 2 — versiones congeladas (gfx803 / ROCm / PyTorch / MACE).
# Combinación conservadora priorizando: gfx803 > estabilidad > reproducibilidad > MACE > rendimiento.
# gfx803 NO tiene soporte oficial en ROCm 5.x/6.x → PyTorch se compila desde fuente para gfx803.

UBUNTU_VERSION=22.04          # ROCm 5.7 targetea 22.04 (no 24.04 del host; el contenedor aísla esto)
ROCM_VERSION=5.7.1            # última con ruta gfx803 comunitaria viable; rocBLAS clásico, sin hipBLASLt
PYTHON_VERSION=3.10
PYTORCH_VERSION=2.2.2         # compilado desde fuente con PYTORCH_ROCM_ARCH=gfx803
TORCHVISION_VERSION=0.17.2    # par con torch 2.2.2
NUMPY_VERSION=1.26.4          # <2.0 por compat torch 2.2 / MACE
ASE_VERSION=3.22.1
MACE_VERSION=0.3.6            # mace-torch compatible con torch 2.2 (Fase 8)
MAMBA_VERSION=1.5.8           # micromamba

# Imagen resultante (NO usar solo 'latest'):
IMAGE_NAME=revive-pytorch-gfx803
IMAGE_TAG=rocm5.7.1-torch2.2.2-py310
